 def _anthropic_event(event_type: str, data: dict) -> str:
     """Format one named Anthropic-style SSE event (`event: <type>` line + `data: <json>` line)."""
     return f"event: {event_type}\ndata: {json.dumps(data)}\n\n"
 
 
