# Postgres (async driver)
DATABASE_URL=postgresql+asyncpg://gatekeep:gatekeep@localhost:5432/gatekeep

# Separate database the test suite runs against. Tests drop and recreate the
# whole schema on every run (see tests/conftest.py), so this must never be the
# same database as DATABASE_URL. Created automatically if it doesn't exist.
TEST_DATABASE_URL=postgresql+asyncpg://gatekeep:gatekeep@localhost:5432/gatekeep_test

# Redis (used from Phase 2 onward)
REDIS_URL=redis://localhost:6379/0

# Anthropic API key the gateway uses to call Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model the `gatekeep eval` CLI generates with when a command specifies none.
# The request path does NOT use this: an unrecognised model resolves through the
# alias table, then Ollama (see gatekeep/providers/README.md).
DEFAULT_MODEL=claude-sonnet-5
DEFAULT_MAX_TOKENS=4096

# Ollama host (for local ollama)
OLLAMA_HOST=http://localhost:11434

# Optional: only needed if routing to real OpenAI/Google via the openai/ or
# google/ model prefix (e.g. model="openai/gpt-4o"). Bare model names never
# need these - they resolve through the alias table or Ollama instead.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Gatekeep API
GATEKEEP_API_KEY=gk-your-gatekeep-key-here

# Eval gate (Phase 3)
# Fixed, stronger judge model used for llm_judge eval checks (decoupled from the
# model under test to avoid self-preference bias).
EVAL_JUDGE_MODEL=claude-sonnet-5
# Default pass_threshold applied to a new suite when none is given.
EVAL_PASS_THRESHOLD_DEFAULT=0.9

# Self-serve signup and authentication
# Email backend: "console" logs links to stdout (dev only), "smtp" sends real mail.
EMAIL_BACKEND=console
# Sender email address for verification and password reset links.
EMAIL_FROM=gatekeep@localhost
# SMTP configuration (only needed if EMAIL_BACKEND=smtp).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
# Enable TLS for SMTP connections.
SMTP_USE_TLS=true
# Public URL of the dashboard SPA, used in verification/reset links.
# The dashboard is always served under /dashboard (vite.config.ts base) -
# include that segment here or generated links will 404. For `docker
# compose` (gateway on :8100) use http://localhost:8100/dashboard instead.
PUBLIC_BASE_URL=http://localhost:5173/dashboard
# Login session lifetime in seconds (default: 14 days).
SESSION_TTL_SECONDS=1209600
# Email verification and password reset link lifetime in seconds (default: 1 day).
EMAIL_TOKEN_TTL_SECONDS=86400